# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
APP_VERSION=development

# PostgreSQL
# A complete URL takes precedence over the individual DB_* settings.
# Set this to a complete PostgreSQL connection URL when using a managed database.
DATABASE_URL=
DB_ENGINE=django.db.backends.postgresql
DB_NAME=paper
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# External scholarly services
MENDELEY_ID=
MENDELEY_SECRET=
TWITTER_BEARER=
OPENALEX_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.1
CROSSREF_EMAIL=
ARXIV_MIN_INTERVAL_SECONDS=3.0
UNPAYWALL_EMAIL=
SEMANTIC_SEARCH_ENABLED=true
SPECTER2_CACHE_PATH=artifacts/paper_recommendation_scope_v2.specter2.npz
LIVE_SEARCH_CACHE_SECONDS=300
RETRIEVAL_TELEMETRY_ENABLED=true
RETRIEVAL_TELEMETRY_STORE_QUERY_TEXT=false
RETRIEVAL_TELEMETRY_HMAC_KEY=replace-with-a-separate-random-value
LLM_QUERY_EXPANSION_ENABLED=false
LLM_QUERY_EXPANSION_TRAFFIC_PERCENT=0
LLM_QUERY_EXPANSION_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_QUERY_EXPANSION_API_KEY=
LLM_QUERY_EXPANSION_MODEL=gpt-5.6-luna
LLM_QUERY_EXPANSION_TIMEOUT_SECONDS=8
LLM_QUERY_EXPANSION_MAX_CHARS=1000
LLM_QUERY_EXPANSION_MAX_OUTPUT_TOKENS=120
LLM_QUERY_EXPANSION_CACHE_SECONDS=604800
LLM_QUERY_EXPANSION_INPUT_USD_PER_MILLION=
LLM_QUERY_EXPANSION_CACHED_INPUT_USD_PER_MILLION=
LLM_QUERY_EXPANSION_OUTPUT_USD_PER_MILLION=
LLM_QUERY_EXPANSION_STAFF_ONLY=true
LLM_QUERY_EXPANSION_DAILY_BUDGET_USD=1.0
LLM_QUERY_EXPANSION_FAILURE_THRESHOLD=3
LLM_QUERY_EXPANSION_FAILURE_WINDOW_SECONDS=300
LLM_QUERY_EXPANSION_CIRCUIT_COOLDOWN_SECONDS=300
SEMANTIC_SEARCH_WARMUP_QUERY=scientific paper recommendation
SEMANTIC_SEARCH_REQUIRE_WARM_READY=false
SEMANTIC_SEARCH_WARMUP_RUNSERVER=false
UNPAYWALL_MIN_INTERVAL_SECONDS=0.2

# Email (console backend is used unless changed)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost
