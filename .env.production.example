# Copy to .env.production, chmod 600, and replace every placeholder.
COMPOSE_PROJECT_NAME=papermetrix
APP_VERSION=local
APP_DOMAIN=papers.example.org
ACME_EMAIL=admin@example.org

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=papers.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://papers.example.org
DJANGO_ADMIN_PATH=control
DJANGO_TIME_ZONE=UTC
DJANGO_TRUST_PROXY_HEADERS=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO

# Complete PostgreSQL connection URL supplied by the production database provider.
DATABASE_URL=
DB_CONN_MAX_AGE=60
DATABASE_WAIT_TIMEOUT=120

REDIS_PASSWORD=replace-with-a-long-random-redis-password
CELERY_BROKER_URL=redis://:replace-with-the-same-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-the-same-redis-password@redis:6379/0
DJANGO_CACHE_URL=redis://:replace-with-the-same-redis-password@redis:6379/2
SEMANTIC_SEARCH_ENABLED=true
SPECTER2_CACHE_PATH=/app/artifacts/paper_recommendation_scope_v2.specter2.npz
LIVE_SEARCH_CACHE_SECONDS=300
RETRIEVAL_TELEMETRY_ENABLED=true
RETRIEVAL_TELEMETRY_STORE_QUERY_TEXT=false
RETRIEVAL_TELEMETRY_HMAC_KEY=replace-with-a-separate-random-value
LLM_QUERY_EXPANSION_ENABLED=false
LLM_QUERY_EXPANSION_TRAFFIC_PERCENT=0
LLM_QUERY_EXPANSION_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_QUERY_EXPANSION_API_KEY=
LLM_QUERY_EXPANSION_MODEL=gpt-5.6-luna
LLM_QUERY_EXPANSION_TIMEOUT_SECONDS=8
LLM_QUERY_EXPANSION_MAX_CHARS=1000
LLM_QUERY_EXPANSION_MAX_OUTPUT_TOKENS=120
LLM_QUERY_EXPANSION_CACHE_SECONDS=604800
LLM_QUERY_EXPANSION_INPUT_USD_PER_MILLION=
LLM_QUERY_EXPANSION_CACHED_INPUT_USD_PER_MILLION=
LLM_QUERY_EXPANSION_OUTPUT_USD_PER_MILLION=
LLM_QUERY_EXPANSION_STAFF_ONLY=true
LLM_QUERY_EXPANSION_DAILY_BUDGET_USD=1.0
LLM_QUERY_EXPANSION_FAILURE_THRESHOLD=3
LLM_QUERY_EXPANSION_FAILURE_WINDOW_SECONDS=300
LLM_QUERY_EXPANSION_CIRCUIT_COOLDOWN_SECONDS=300
SEMANTIC_SEARCH_WARMUP_QUERY=scientific paper recommendation
SEMANTIC_SEARCH_REQUIRE_WARM_READY=true
SEMANTIC_SEARCH_WARMUP_RUNSERVER=false
CELERY_WORKER_CONCURRENCY=1
CELERY_MAX_TASKS_PER_CHILD=100

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_FORWARDED_ALLOW_IPS=*

OPENALEX_EMAIL=researcher@example.org
CROSSREF_EMAIL=researcher@example.org
UNPAYWALL_EMAIL=researcher@example.org
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.1
ARXIV_MIN_INTERVAL_SECONDS=3.0
UNPAYWALL_MIN_INTERVAL_SECONDS=0.2

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PaperMetrix <noreply@example.org>
SERVER_EMAIL=PaperMetrix Errors <errors@example.org>
